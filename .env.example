# Copia este archivo a .env y rellena los valores:
#   cp .env.example .env

# Proveedor de LLM: "openai" o "azure"
LLM_PROVIDER=openai

# OpenAI (solo si LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Azure OpenAI (solo si LLM_PROVIDER=azure). Los modelos se indican por nombre de DEPLOYMENT.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_VERSION=

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB_NAME=default
MILVUS_PARTITION_NAME_DOCUMENTS=documents
MILVUS_PARTITION_NAME_SUMMARIES=summaries

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me
MONGO_DB_NAME=rag
MONGO_LOGS_COLLECTION=logs

# Logs Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
MONGO_LOG_LEVEL=WARNING